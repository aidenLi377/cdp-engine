# Core server settings
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

# AI natural-language audience builder (server-side only)
CDP_AI_API_KEY=replace-with-provider-api-key
CDP_AI_MODEL=replace-with-model-name
CDP_AI_BASE_URL=https://api.openai.com/v1
CDP_AI_API_STYLE=responses
CDP_AI_OUTPUT_MODE=json_schema
CDP_AI_TIMEOUT_SECONDS=60
CDP_AI_MAX_INPUT_TOKENS=128000
CDP_AI_MAX_OUTPUT_TOKENS=4000
CDP_AI_TOKEN_FIELD=max_tokens
CDP_AI_REASONING_EFFORT=
CDP_AI_THINKING_MODE=

# Only enable this for a trusted endpoint that intentionally has no API key.
CDP_AI_ALLOW_NO_API_KEY=false

# Production-only optional path; defaults to /srv/cdp/shared/ai.env.
CDP_AI_ENV_PATH=/srv/cdp/shared/ai.env
